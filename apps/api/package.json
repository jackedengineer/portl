{
  "name": "@portl/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "worker": "tsx --env-file-if-exists=.env src/worker.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "seed": "tsx --env-file-if-exists=.env src/seed.ts",
    "bootstrap": "tsx --env-file-if-exists=.env src/bootstrap.ts"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.7",
    "@portl/contracts": "workspace:*",
    "@portl/database": "workspace:*",
    "@portl/domain": "workspace:*",
    "better-auth": "1.7.7",
    "cors": "^2.8.5",
    "drizzle-orm": "0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "nodemailer": "^7.0.12",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "socket.io": "^4.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^7.0.11",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0"
  }
}
